<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>ru.aasmc</groupId>
        <artifactId>trace-collector</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>tc-ingester</artifactId>
    <name>tc-ingester</name>
    <description>Consumes otlp-traces and writes traces to PostgreSQL</description>

    <dependencies>
        <dependency>
            <groupId>ru.aasmc</groupId>
            <artifactId>tc-persistence</artifactId>
        </dependency>        <dependency>
            <groupId>ru.aasmc</groupId>
            <artifactId>tc-kafka-support</artifactId>
        </dependency>        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-kafka</artifactId>
        </dependency>        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>
        <!-- tests: full-context integration tests only -->
        <dependency>
            <groupId>ru.aasmc</groupId>
            <artifactId>tc-test-infra</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
